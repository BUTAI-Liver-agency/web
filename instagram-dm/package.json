{
  "name": "butai-instagram-dm",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "test": "node --test test/system.test.mjs cloudflare/test.mjs",
    "dev:cloudflare": "wrangler dev --config cloudflare/wrangler.jsonc",
    "check:cloudflare": "wrangler deploy --config cloudflare/wrangler.jsonc --dry-run",
    "deploy:cloudflare": "wrangler d1 migrations apply butai-instagram-dm --remote --config cloudflare/wrangler.jsonc && wrangler deploy --config cloudflare/wrangler.jsonc"
  },
  "devDependencies": {
    "wrangler": "4.148.0"
  }
}
