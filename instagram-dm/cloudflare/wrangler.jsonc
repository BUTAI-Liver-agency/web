{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "butai-instagram-dm",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-07",
  "workers_dev": true,
  "assets": {
    "directory": "../public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/webhook", "/healthz"],
    "not_found_handling": "none"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "butai-instagram-dm",
    "database_id": "REPLACE_WITH_D1_DATABASE_ID",
    "migrations_dir": "migrations"
  }],
  "triggers": {"crons": ["* * * * *"]},
  "vars": {"GRAPH_API_VERSION": "v24.0", "DRY_RUN": "true"},
  "observability": {"enabled": false}
}
